{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "type": "object",
  "required": ["_id", "use_case_id", "stage", "check", "verdict", "scope", "detail"],
  "properties": {
    "_id": { "type": "string" },
    "use_case_id": { "type": "string" },
    "stage": { "enum": ["compile", "validate", "revalidate"] },
    "merged_version": { "type": "integer" },
    "check": { "type": "string", "pattern": "^(LINT|IO|STR|PRE|POL|FAIL|DUP|TOOL|CONF|ALN|PRIV|INV)-[0-9]{2}$" },
    "verdict": { "enum": ["pass", "fail", "guarded"] },
    "scope": { "type": "string" },
    "detail": { "type": "string" },
    "rung": { "type": "integer", "minimum": 1, "maximum": 6 },
    "stakes": { "enum": ["low", "high"] },
    "stakes_reason": { "type": "string" },
    "owner_org": { "enum": ["A", "B", "agent", "validator"] },
    "locality": { "enum": ["local", "mediator"] },
    "resolved_by": { "type": ["string", "null"] }
  }
}
